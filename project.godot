; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fantasy Shop"
run/main_scene="uid://drk0esrvu7oht"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
GameManager="*uid://cmhoehm4acy57"
PopoverManager="*uid://lmladihd01m5"

[dialogue_manager]

runtime/balloon_path="res://DialogueBallons/balloon.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/initial_position_type=3
window/size/initial_screen=1
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/disable_vsync=true
naming/scene_name_casing=1
naming/script_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray"
}

[internationalization]

locale/translations_pot_files=PackedStringArray("res://Dialogues/buying.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
